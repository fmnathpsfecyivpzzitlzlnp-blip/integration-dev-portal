    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const table = document.getElementById("dashboard-table");
            if (!table.querySelector("thead tr")) return;
            const thead = table.querySelector("thead tr");
            const tbody = table.querySelector("tbody");
            const rows = Array.from(tbody.querySelectorAll("tr"));
            const stateKey = "dashboardComplexState";
            
            let headers = Array.from(thead.children).map(th => th.textContent.trim());
            
            let state = JSON.parse(localStorage.getItem(stateKey));
            if (!state) {
                state = { hiddenCols: [], textFilters: {}, checkFilters: {}, sortCol: null, sortAsc: true };
                let jiraIdx = headers.findIndex(h => h.includes("Импорт кастомных полей Jira"));
                if(jiraIdx > -1) state.hiddenCols.push(String(jiraIdx));
            }
            
            window.resetSettings = () => { localStorage.removeItem(stateKey); location.reload(); };
            const saveState = () => localStorage.setItem(stateKey, JSON.stringify(state));

            const colToggleContainer = document.getElementById('columns-toggle');
            headers.forEach((name, i) => {
                let isHidden = state.hiddenCols.includes(String(i));
                let checkedStr = isHidden ? '' : 'checked';
                colToggleContainer.innerHTML += `<label><input type="checkbox" class="global-col-toggle" data-col="${i}" ${checkedStr}> ${name}</label>`;
            });

            function getUniqueValues(colIdx) {
                let vals = new Set();
                rows.forEach(r => { if(r.children[colIdx]) vals.add(r.children[colIdx].textContent.trim()); });
                return Array.from(vals).filter(v => v !== '').sort();
            }

            Array.from(thead.children).forEach((th, i) => {
                const originalText = headers[i];
                const uniqueVals = getUniqueValues(i);
                let checkboxesHtml = uniqueVals.map(val => {
                    let isChecked = state.checkFilters[i] && state.checkFilters[i].includes(val) ? 'checked' : '';
                    return `<label><input type="checkbox" class="val-check" data-col="${i}" value="${val}" ${isChecked}> <span>${val}</span></label>`;
                }).join('');

                th.innerHTML = `
                    <div class="col-header sortable" data-col="${i}">
                        <span>${originalText}</span> <span>${state.sortCol == i ? (state.sortAsc ? '▲' : '▼') : ''}</span>
                    </div>
                    <input type="text" class="col-filter" data-col="${i}" placeholder="Текст..." value="${state.textFilters[i] || ''}">
                    <div style="position: relative;">
                        <button class="dropdown-btn" data-col="${i}">Значения ▼</button>
                        <div class="dropdown-content">${checkboxesHtml}</div>
                    </div>
                    <button class="hide-btn" data-col="${i}">Скрыть столбец</button>
                `;
            });

            document.addEventListener('click', e => {
                const isDropdownBtn = e.target.classList.contains('dropdown-btn');
                const isInsideDropdown = e.target.closest('.dropdown-content');

                if (!isDropdownBtn && !isInsideDropdown) {
                    document.querySelectorAll('.dropdown-content').forEach(el => {
                        el.style.display = 'none';
                        el.closest('th').style.zIndex = '10';
                    });
                } else if (isDropdownBtn) {
                    document.querySelectorAll('.dropdown-content').forEach(el => {
                        if (el !== e.target.nextElementSibling) {
                            el.style.display = 'none';
                            el.closest('th').style.zIndex = '10';
                        }
                    });
                    const content = e.target.nextElementSibling;
                    const th = e.target.closest('th');
                    if (content.style.display === 'block') {
                        content.style.display = 'none';
                        th.style.zIndex = '10';
                    } else {
                        content.style.display = 'block';
                        th.style.zIndex = '100';
                    }
                }
            });

            document.addEventListener('change', e => {
                if (e.target.classList.contains('global-col-toggle')) {
                    let col = e.target.getAttribute('data-col');
                    if (e.target.checked) state.hiddenCols = state.hiddenCols.filter(c => c !== col);
                    else if (!state.hiddenCols.includes(col)) state.hiddenCols.push(col);
                    saveState(); applyState();
                }
                if (e.target.classList.contains('val-check')) {
                    let col = e.target.getAttribute('data-col');
                    let val = e.target.value;
                    if (!state.checkFilters[col]) state.checkFilters[col] = [];
                    if (e.target.checked) state.checkFilters[col].push(val);
                    else state.checkFilters[col] = state.checkFilters[col].filter(v => v !== val);
                    saveState(); applyState();
                }
            });

            table.addEventListener('input', e => {
                if (e.target.classList.contains('col-filter')) {
                    state.textFilters[e.target.getAttribute('data-col')] = e.target.value.toLowerCase();
                    saveState(); applyState();
                }
            });

            table.addEventListener('click', e => {
                if (e.target.classList.contains('hide-btn')) {
                    let col = e.target.getAttribute('data-col');
                    if (!state.hiddenCols.includes(col)) state.hiddenCols.push(col);
                    document.querySelector(`.global-col-toggle[data-col="${col}"]`).checked = false;
                    saveState(); applyState();
                }
                let sortable = e.target.closest('.sortable');
                if (sortable) {
                    let col = sortable.getAttribute('data-col');
                    if (state.sortCol == col) state.sortAsc = !state.sortAsc;
                    else { state.sortCol = col; state.sortAsc = true; }
                    saveState(); location.reload();
                }
            });

            function applyState() {
                Array.from(thead.children).forEach((th, i) => {
                    let hide = state.hiddenCols.includes(String(i));
                    th.style.display = hide ? 'none' : '';
                    rows.forEach(r => { if(r.children[i]) r.children[i].style.display = hide ? 'none' : ''; });
                });

                let visibleCount = 0;
                let statusCounts = {};
                let statusColIdx = headers.findIndex(h => h.toLowerCase().includes('статус') || h.toLowerCase().includes('состояние'));

                rows.forEach(row => {
                    let show = true;
                    for (let i = 0; i < headers.length; i++) {
                        let cellText = row.children[i] ? row.children[i].textContent.trim() : '';
                        let tFilter = state.textFilters[i];
                        if (tFilter && !cellText.toLowerCase().includes(tFilter)) { show = false; break; }
                        
                        let cFilter = state.checkFilters[i];
                        if (cFilter && cFilter.length > 0 && !cFilter.includes(cellText)) { show = false; break; }
                    }
                    row.style.display = show ? '' : 'none';
                    
                    if (show) {
                        visibleCount++;
                        if (statusColIdx > -1 && row.children[statusColIdx]) {
                            let status = row.children[statusColIdx].textContent.trim();
                            statusCounts[status] = (statusCounts[status] || 0) + 1;
                        }
                    }
                });

                let summaryHtml = `<div class="summary-box"><h4>Всего задач</h4><div class="summary-item"><span>Отображается:</span> <strong>${visibleCount}</strong></div></div>`;
                if (Object.keys(statusCounts).length > 0) {
                    let stats = Object.entries(statusCounts).map(([k,v]) => `<div class="summary-item"><span>${k || 'Пусто'}:</span> <strong>${v}</strong></div>`).join('');
                    summaryHtml += `<div class="summary-box"><h4>Разбивка по статусам</h4>${stats}</div>`;
                }
                document.getElementById('summary-panel').innerHTML = summaryHtml;
            }
            applyState();
        });
    </script>
